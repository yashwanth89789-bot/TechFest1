# Environment Configuration for TechFest Hub

# Server Port
PORT=3000

# Node Environment
NODE_ENV=development

# JSON Web Token Secret
JWT_SECRET="replace-with-a-secure-random-secret-key-in-production"

# Production PostgreSQL Database Connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/techfesthub?schema=public"

# Gemini API Key (injected automatically in Google AI Studio if configured)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Hosted Application URL
APP_URL="MY_APP_URL"
