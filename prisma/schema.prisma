generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum Role {
  STUDENT
  ORGANIZER
  ADMIN
}

enum EventStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum EventFormat {
  OFFLINE
  ONLINE
  HYBRID
}

enum RegistrationType {
  INDIVIDUAL
  TEAM
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  WAITLISTED
  REJECTED
  CANCELLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id               String          @id @default(cuid())
  email            String          @unique
  passwordHash     String
  name             String
  role             String          @default("STUDENT") // STUDENT, ORGANIZER, ADMIN
  isSuspended      Boolean         @default(false)
  avatarUrl        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  profile          Profile?
  organizedEvents  Event[]         @relation("OrganizerEvents")
  registrations    Registration[]
  ledTeams         Team[]          @relation("TeamLeader")
  teamMemberships  TeamMembership[]
  sentInvitations  TeamInvitation[] @relation("SentInvitations")
  receivedInvitations TeamInvitation[] @relation("ReceivedInvitations")
  notifications    Notification[]
  certificates     Certificate[]
  auditLogs        AuditLog[]
  passwordResets   PasswordResetToken[]
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  college         String?
  department      String?
  graduationYear  Int?
  studentIdNumber String?
  phoneNumber     String?
  githubUrl       String?
  linkedinUrl     String?
  bio             String?
  skills          String?  // comma-separated or JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EventCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?  // Lucide icon name
  color       String?  // Badge color theme
  events      Event[]
}

model Event {
  id                 String           @id @default(cuid())
  title              String
  slug               String           @unique
  description        String
  shortDescription   String?
  categoryId         String
  category           EventCategory    @relation(fields: [categoryId], references: [id])
  organizerId        String
  organizer          User             @relation("OrganizerEvents", fields: [organizerId], references: [id])
  bannerUrl          String?
  format             String           @default("OFFLINE") // OFFLINE, ONLINE, HYBRID
  venue              String?
  onlineLink         String?
  startDate          DateTime
  endDate            DateTime
  registrationDeadline DateTime
  capacity           Int              @default(100)
  registrationType   String           @default("INDIVIDUAL") // INDIVIDUAL, TEAM
  minTeamSize        Int              @default(1)
  maxTeamSize        Int              @default(4)
  eligibility        String?
  rules              String?
  prizes             String?
  status             String           @default("PUBLISHED") // DRAFT, PENDING_APPROVAL, PUBLISHED, CANCELLED, COMPLETED
  cancellationReason String?
  approvalNotes      String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  registrations      Registration[]
  teams              Team[]
  certificates       Certificate[]
  attendances        Attendance[]
}

model Registration {
  id               String             @id @default(cuid())
  registrationNumber String           @unique // e.g. REG-2026-XXXXX
  eventId          String
  event            Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId           String?
  team             Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  status           String             @default("CONFIRMED") // PENDING, CONFIRMED, WAITLISTED, REJECTED, CANCELLED
  waitlistPosition Int?
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  ticket           Ticket?
  attendance       Attendance?

  @@unique([eventId, userId])
}

model Team {
  id           String           @id @default(cuid())
  name         String
  code         String           @unique // Join code e.g. TEAM-XXXX
  eventId      String
  event        Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  leaderId     String
  leader       User             @relation("TeamLeader", fields: [leaderId], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  members      TeamMembership[]
  invitations  TeamInvitation[]
  registrations Registration[]
}

model TeamMembership {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER") // LEADER, MEMBER
  joinedAt  DateTime @default(now())

  @@unique([teamId, userId])
}

model TeamInvitation {
  id         String   @id @default(cuid())
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inviterId  String
  inviter    User     @relation("SentInvitations", fields: [inviterId], references: [id])
  inviteeId  String
  invitee    User     @relation("ReceivedInvitations", fields: [inviteeId], references: [id])
  status     String   @default("PENDING") // PENDING, ACCEPTED, DECLINED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([teamId, inviteeId])
}

model Ticket {
  id             String       @id @default(cuid())
  registrationId String       @unique
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  ticketToken    String       @unique // Secure random unguessable token
  qrCodeData     String       // Data encoded in QR
  issuedAt       DateTime     @default(now())
}

model Attendance {
  id             String       @id @default(cuid())
  eventId        String
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrationId String       @unique
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  checkedInById  String?
  checkedInAt    DateTime     @default(now())
  checkInMethod  String       @default("QR_SCAN") // QR_SCAN, MANUAL
}

model Certificate {
  id             String   @id @default(cuid())
  certificateNumber String @unique // CERT-XXXX-XXXX
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  recipientName  String
  issuedAt       DateTime @default(now())
  verificationUrl String?
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("GENERAL") // REGISTRATION, WAITLIST, APPROVAL, ATTENDANCE, CERTIFICATE, TEAM
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  targetType String
  targetId  String?
  details   String?  // JSON string
  ipAddress String?
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}
